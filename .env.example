# Copy this file to .env and fill in the values (.env is never committed).

# Claude subscription: run `claude setup-token` on your machine and paste the token (sk-ant-oat…)
CLAUDE_CODE_OAUTH_TOKEN=

# Slack (Socket Mode), see the Slack section of the README
# api.slack.com/apps > your app > Install App > Bot User OAuth Token (xoxb-…)
HIVE_SLACK_BOT_TOKEN=
# api.slack.com/apps > your app > Basic Information > App-Level Tokens, scope connections:write (xapp-…)
HIVE_SLACK_APP_TOKEN=

# Optional: uid of the container user (on Linux, use the output of `id -u`)
# HIVE_UID=1000
